+/** 扇のように重ねた3枚の取り札。 */
+@Composable
+private fun FannedCards(modifier: Modifier = Modifier) {
+    val cards = Poems.all.take(3)
+    Box(modifier.size(width = 190.dp, height = 96.dp), contentAlignment = Alignment.Center) {
