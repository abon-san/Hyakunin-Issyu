+package io.github.abonsan.hyakunin.ui
+
+import io.github.abonsan.hyakunin.data.Poem
+import io.github.abonsan.hyakunin.data.Poems
+import io.github.abonsan.hyakunin.game.FieldCard
+import io.github.abonsan.hyakunin.game.GameConfig
+import io.github.abonsan.hyakunin.game.MatchActions
+import io.github.abonsan.hyakunin.game.MatchPhase
+import io.github.abonsan.hyakunin.game.MatchUiState
+import io.github.abonsan.hyakunin.game.ReadResult
+import io.github.abonsan.hyakunin.game.ReadingState
+import io.github.abonsan.hyakunin.game.Side
+import io.github.abonsan.hyakunin.game.Transfer
+
+/** スクリーンショットとテスト用の偽の対戦状態。 */
+internal object Fixtures {
+    /** 1〜3番はアプリのデータ、4〜12番はテスト用に用意した歌。 */
+    val poems: List<Poem> = Poems.all.take(3) + listOf(
+        Poem(
+            no = 4,
+            kami = "田子の浦に　うち出でてみれば　白妙の",
+            shimo = "富士の高嶺に　雪は降りつつ",
+            kamiYomi = "たごのうらに　うちいでてみれば　しろたえの",
+            shimoYomi = "ふじのたかねに　ゆきはふりつつ",
+            shimoKana = "ふじのたかねに　ゆきはふりつつ",
+            author = "山部赤人",
+            authorYomi = "やまべのあかひと",
+        ),
+        Poem(
+            no = 5,
+            kami = "奥山に　紅葉踏み分け　鳴く鹿の",
+            shimo = "声聞く時ぞ　秋は悲しき",
+            kamiYomi = "おくやまに　もみじふみわけ　なくしかの",
+            shimoYomi = "こえきくときぞ　あきはかなしき",
+            shimoKana = "こゑきくときぞ　あきはかなしき",
+            author = "猿丸大夫",
+            authorYomi = "さるまるだゆう",
+        ),
+        Poem(
+            no = 6,
+            kami = "かささぎの　渡せる橋に　置く霜の",
+            shimo = "白きを見れば　夜ぞ更けにける",
+            kamiYomi = "かささぎの　わたせるはしに　おくしもの",
+            shimoYomi = "しろきをみれば　よぞふけにける",
+            shimoKana = "しろきをみれば　よぞふけにける",
+            author = "中納言家持",
+            authorYomi = "ちゅうなごんやかもち",
+        ),
+        Poem(
+            no = 7,
+            kami = "天の原　ふりさけ見れば　春日なる",
+            shimo = "三笠の山に　出でし月かも",
+            kamiYomi = "あまのはら　ふりさけみれば　かすがなる",
+            shimoYomi = "みかさのやまに　いでしつきかも",
+            shimoKana = "みかさのやまに　いでしつきかも",
+            author = "安倍仲麿",
+            authorYomi = "あべのなかまろ",
+        ),
+        Poem(
+            no = 8,
+            kami = "わが庵は　都のたつみ　しかぞ住む",
+            shimo = "世をうぢ山と　人はいふなり",
+            kamiYomi = "わがいおは　みやこのたつみ　しかぞすむ",
+            shimoYomi = "よをうじやまと　ひとはいうなり",
+            shimoKana = "よをうぢやまと　ひとはいふなり",
+            author = "喜撰法師",
+            authorYomi = "きせんほうし",
+        ),
+        Poem(
+            no = 9,
+            kami = "花の色は　移りにけりな　いたづらに",
+            shimo = "わが身世にふる　ながめせし間に",
+            kamiYomi = "はなのいろは　うつりにけりな　いたずらに",
+            shimoYomi = "わがみよにふる　ながめせしまに",
+            shimoKana = "わがみよにふる　ながめせしまに",
+            author = "小野小町",
+            authorYomi = "おののこまち",
+        ),
+        Poem(
+            no = 10,
+            kami = "これやこの　行くも帰るも　別れては",
+            shimo = "知るも知らぬも　逢坂の関",
+            kamiYomi = "これやこの　ゆくもかえるも　わかれては",
+            shimoYomi = "しるもしらぬも　おうさかのせき",
+            shimoKana = "しるもしらぬも　あふさかのせき",
+            author = "蝉丸",
+            authorYomi = "せみまる",
+        ),
+        Poem(
+            no = 11,
+            kami = "わたの原　八十島かけて　漕ぎ出でぬと",
+            shimo = "人には告げよ　海人の釣舟",
+            kamiYomi = "わたのはら　やそしまかけて　こぎいでぬと",
+            shimoYomi = "ひとにはつげよ　あまのつりぶね",
+            shimoKana = "ひとにはつげよ　あまのつりぶね",
+            author = "参議篁",
+            authorYomi = "さんぎたかむら",
+        ),
+        Poem(
+            no = 12,
+            kami = "天つ風　雲の通ひ路　吹き閉ぢよ",
+            shimo = "をとめの姿　しばしとどめむ",
+            kamiYomi = "あまつかぜ　くものかよいじ　ふきとじよ",
+            shimoYomi = "おとめのすがた　しばしとどめん",
+            shimoKana = "をとめのすがた　しばしとどめむ",
+            author = "僧正遍昭",
+            authorYomi = "そうじょうへんじょう",
+        ),
+    )
+
+    fun poem(no: Int): Poem = poems.first { it.no == no }
+
+    fun card(no: Int, isNew: Boolean = false) = FieldCard(no, poem(no).shimoKana, isNew)
+
+    fun reading(no: Int, readNumber: Int, totalReads: Int, revealed: Int): ReadingState {
+        val poem = poem(no)
+        val kami = poem.kamiYomi.count { !it.isWhitespace() }
+        val total = kami + poem.shimoYomi.count { !it.isWhitespace() }
+        return ReadingState(
+            poem = poem,
+            readNumber = readNumber,
+            totalReads = totalReads,
+            revealedKana = revealed.coerceAtMost(total),
+            kamiKanaCount = kami,
+            totalKanaCount = total,
+        )
+    }
+
+    fun result(
+        no: Int,
+        kimarijiLength: Int,
+        revealedAtTake: Int?,
+        takenBy: Side?,
+        takenFrom: Side?,
+        message: String,
+        isEmptyCard: Boolean = false,
+        faults: Set<Side> = emptySet(),
+        safeMisses: Set<Side> = emptySet(),
+        transfers: List<Transfer> = emptyList(),
+    ) = ReadResult(
+        poem = poem(no),
+        isEmptyCard = isEmptyCard,
+        kimarijiLength = kimarijiLength,
+        revealedAtTake = revealedAtTake,
+        takenBy = takenBy,
+        takenFrom = takenFrom,
+        faults = faults,
+        safeMisses = safeMisses,
+        transfers = transfers,
+        message = message,
+    )
+
+    fun state(
+        config: GameConfig = GameConfig(),
+        phase: MatchPhase = MatchPhase.Reading,
+        player: List<FieldCard> = listOf(1, 2, 3, 4, 5).map { card(it) },
+        cpu: List<FieldCard> = listOf(6, 7, 8, 9, 10).map { card(it) },
+        reading: ReadingState? = null,
+        lastResult: ReadResult? = null,
+        playerLockedOut: Boolean = false,
+        pendingPlayerSends: Int = 0,
+        playerTaken: Int = 0,
+        cpuTaken: Int = 0,
+        playerFaults: Int = 0,
+        cpuFaults: Int = 0,
+        readsDone: Int = 0,
+        isPaused: Boolean = false,
+    ) = MatchUiState(
+        config = config,
+        phase = phase,
+        playerCards = player,
+        cpuCards = cpu,
+        reading = reading,
+        lastResult = lastResult,
+        playerLockedOut = playerLockedOut,
+        pendingPlayerSends = pendingPlayerSends,
+        playerTakenCount = playerTaken,
+        cpuTakenCount = cpuTaken,
+        playerFaultCount = playerFaults,
+        cpuFaultCount = cpuFaults,
+        readsDone = readsDone,
+        totalReads = 2 * GameConfig.CARDS_PER_SIDE + config.emptyCardCount,
+        isPaused = isPaused,
+    )
+}
+
+/** 何もしない操作。 */
+internal object NoopActions : MatchActions {
+    override fun onCardTap(side: Side, poemNo: Int) = Unit
+
+    override fun onNext() = Unit
+
+    override fun onRestart() = Unit
+
+    override fun setPaused(paused: Boolean) = Unit
+}
