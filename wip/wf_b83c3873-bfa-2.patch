+/** 対戦設定の画面の見出し。 */
+internal const val MATCH_SETUP_CAPTION = "対戦設定"
+
+/**
+ * 対戦設定の画面。[config] のモードで、空札・CPU・読み上げ・読み始めの設定を変えて対戦を始める。
+ * 設定の保存は呼び出し側が [onConfigChange] で行う。
+ * 横に広い画面では設定を2列で並べ、十分に広ければ左に見出しと「対戦開始」を置く
+ * （広さが足りなければ、見出しと「対戦開始」を上の帯にまとめる）。
+ */
+@Composable
+fun MatchSetupScreen(
+    config: GameConfig,
+    onConfigChange: (GameConfig) -> Unit,
+    onStart: () -> Unit,
+    onBack: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    BoxWithConstraints(
+        modifier
+            .fillMaxSize()
+            .background(Washi),
+    ) {
+        when {
+            !isWideLayout(maxWidth, maxHeight) -> NarrowSetup(config, onConfigChange, onStart, onBack)
+            maxWidth >= SidePaneMinWidth -> WideSetup(config, onConfigChange, onStart, onBack)
+            else -> TopBarSetup(config, onConfigChange, onStart, onBack)
+        }
+    }
+}
+
+/** 見出しと「対戦開始」を左の欄に置ける幅。 */
+private val SidePaneMinWidth = 760.dp
+
+@Composable
+private fun NarrowSetup(
+    config: GameConfig,
+    onConfigChange: (GameConfig) -> Unit,
+    onStart: () -> Unit,
+    onBack: () -> Unit,
+) {
+    Column(
+        Modifier
+            .fillMaxSize()
+            .windowInsetsPadding(WindowInsets.safeDrawing.only(WindowInsetsSides.Horizontal + WindowInsetsSides.Bottom)),
+        horizontalAlignment = Alignment.CenterHorizontally,
+    ) {
+        ScreenHeader(title = config.ruleMode.modeName, caption = MATCH_SETUP_CAPTION, onBack = onBack)
+        val scroll = rememberScrollState()
+        Column(
+            Modifier
+                .weight(1f)
+                .widthIn(max = 560.dp)
+                .fadingBottomEdge(scroll, Washi)
+                .verticalScroll(scroll)
+                .padding(horizontal = 20.dp),
+        ) {
+            RuleSummary(config.ruleMode, Modifier.padding(start = 4.dp, top = 2.dp, bottom = 14.dp))
+            SettingsCard { MatchSettings(config, onConfigChange, dense = false) }
+            Spacer(Modifier.height(14.dp))
+            SettingsCard { ReadStartSettings(config, onConfigChange, dense = false) }
+            Spacer(Modifier.height(12.dp))
+        }
+        PrimaryButton(
+            text = "対戦開始",
+            onClick = onStart,
+            modifier = Modifier
+                .widthIn(max = 560.dp)
+                .fillMaxWidth()
+                .padding(horizontal = 20.dp, vertical = 12.dp)
+                .height(56.dp),
+        )
+    }
+}
+
+@Composable
+private fun WideSetup(
+    config: GameConfig,
+    onConfigChange: (GameConfig) -> Unit,
+    onStart: () -> Unit,
+    onBack: () -> Unit,
+) {
+    Row(Modifier.fillMaxSize()) {
+        Column(
+            Modifier
+                .weight(0.34f)
+                .fillMaxHeight()
+                .windowInsetsPadding(WindowInsets.safeDrawing.only(WindowInsetsSides.Start + WindowInsetsSides.Vertical)),
+        ) {
+            ScreenHeader(title = config.ruleMode.modeName, caption = MATCH_SETUP_CAPTION, onBack = onBack)
+            val scroll = rememberScrollState()
+            Column(
+                Modifier
+                    .weight(1f)
+                    .fadingBottomEdge(scroll, Washi)
+                    .verticalScroll(scroll),
+            ) {
+                RuleSummary(config.ruleMode, Modifier.padding(start = 20.dp, end = 12.dp, top = 2.dp, bottom = 12.dp))
+            }
+            PrimaryButton(
+                text = "対戦開始",
+                onClick = onStart,
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .padding(start = 16.dp, end = 8.dp, bottom = 12.dp)
+                    .height(56.dp),
+            )
+        }
+        val scroll = rememberScrollState()
+        Row(
+            Modifier
+                .weight(0.66f)
+                .fillMaxHeight()
+                .windowInsetsPadding(WindowInsets.safeDrawing.only(WindowInsetsSides.End + WindowInsetsSides.Vertical))
+                .fadingBottomEdge(scroll, Washi)
+                .verticalScroll(scroll)
+                .padding(start = 8.dp, end = 16.dp, top = 12.dp, bottom = 12.dp),
+            horizontalArrangement = Arrangement.spacedBy(12.dp),
+        ) {
+            SettingsCard(Modifier.weight(1f)) { MatchSettings(config, onConfigChange, dense = true) }
+            SettingsCard(Modifier.weight(1f)) { ReadStartSettings(config, onConfigChange, dense = true) }
+        }
+    }
+}
