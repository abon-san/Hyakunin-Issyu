+                .fillMaxWidth()
+                .windowInsetsPadding(WindowInsets.safeDrawing.only(WindowInsetsSides.Top)),
+            verticalAlignment = Alignment.CenterVertically,
+        ) {
+            ScreenHeader(
+                title = config.ruleMode.modeName,
+                caption = MATCH_SETUP_CAPTION,
+                onBack = onBack,
+                modifier = Modifier.weight(1f),
+            )
+            PrimaryButton(
+                text = "対戦開始",
+                onClick = onStart,
+                modifier = Modifier
+                    .padding(end = 16.dp)
+                    .widthIn(min = 180.dp),
+                minHeight = 48.dp,
+            )
+        }
+        val scroll = rememberScrollState()
+        Row(
+            Modifier
+                .weight(1f)
+                .fadingBottomEdge(scroll, Washi)
+                .verticalScroll(scroll)
+                .padding(start = 16.dp, end = 16.dp, top = 4.dp, bottom = 12.dp),
+            horizontalArrangement = Arrangement.spacedBy(12.dp),
+        ) {
+            SettingsCard(Modifier.weight(1f)) { MatchSettings(config, onConfigChange, dense = true) }
+            SettingsCard(Modifier.weight(1f)) { ReadStartSettings(config, onConfigChange, dense = true) }
+        }
+    }
+}
+
+/** ルールの短い説明。モードの色の縦線を添える。 */
+@Composable
+private fun RuleSummary(mode: RuleMode, modifier: Modifier = Modifier) {
+    Row(modifier.height(IntrinsicSize.Min)) {
+        Box(
+            Modifier
+                .width(3.dp)
+                .fillMaxHeight()
+                .background(mode.accent),
+        )
+        Spacer(Modifier.width(10.dp))
+        Text(
+            text = mode.description,
+            style = MaterialTheme.typography.bodySmall,
+            color = UsuzumiText,
+        )
+    }
+}
+
+/** 空札・CPU の強さ・読み上げ速度。 */
+@Composable
+private fun MatchSettings(config: GameConfig, onConfigChange: (GameConfig) -> Unit, dense: Boolean) {
+    EmptyCardSetting(
+        count = config.emptyCardCount,
+        onCountChange = { count ->
+            val value = count.coerceIn(0, GameConfig.MAX_EMPTY_CARDS)
+            if (value != config.emptyCardCount) onConfigChange(config.copy(emptyCardCount = value))
+        },
+        dense = dense,
+    )
+    PanelDivider()
+    ChoiceSetting(
+        title = "CPUの強さ",
+        options = CpuLevel.entries,
+        selected = config.cpuLevel,
+        label = { it.label },
+        onSelect = { onConfigChange(config.copy(cpuLevel = it)) },
+        dense = dense,
+    )
+    PanelDivider()
+    ChoiceSetting(
+        title = "読み上げ速度",
+        options = ReadingSpeed.entries,
+        selected = config.readingSpeed,
+        label = { it.label },
+        onSelect = { onConfigChange(config.copy(readingSpeed = it)) },
+        dense = dense,
+    )
+}
+
+/** 読み始め方と、自動のときの待ち時間。タップで読み始めるときは待ち時間を選べなくする。 */
+@Composable
+private fun ReadStartSettings(config: GameConfig, onConfigChange: (GameConfig) -> Unit, dense: Boolean) {
+    val auto = config.readStartMode == ReadStartMode.AUTO
+    SettingBlock(dense = dense) {
+        SectionLabel("読み始め方")
+        Spacer(Modifier.height(if (dense) 8.dp else 10.dp))
+        ChoiceRow(
+            options = ReadStartMode.entries,
+            selected = config.readStartMode,
+            label = { it.label },
+            onSelect = { onConfigChange(config.copy(readStartMode = it)) },
+            height = if (dense) 44.dp else 46.dp,
+        )
+        Spacer(Modifier.height(8.dp))
+        SelectedDescription(ReadStartMode.entries, config.readStartMode, { it.setupDescription })
+    }
+    PanelDivider()
+    ChoiceSetting(
+        title = "開始前の時間",
+        caption = "札を覚える時間",
+        options = MemorizeTime.entries,
+        selected = config.memorizeTime,
+        label = { it.label },
+        onSelect = { onConfigChange(config.copy(memorizeTime = it)) },
+        dense = dense,
+        enabled = auto,
+    )
+    PanelDivider()
+    ChoiceSetting(
+        title = "読みの間",
+        caption = "次の札を読むまで",
+        options = ReadInterval.entries,
+        selected = config.readInterval,
+        label = { it.label },
+        onSelect = { onConfigChange(config.copy(readInterval = it)) },
+        dense = dense,
+        enabled = auto,
+    )
+}
+
+/** 対戦設定での読み始め方の説明。 */
+internal val ReadStartMode.setupDescription: String
+    get() = when (this) {
+        ReadStartMode.AUTO -> "下の時間がたつと、自動で次の札を読みます"
+        ReadStartMode.TAP -> "毎回「読み始める」を押すまで待ちます"
+    }
+
+/** 見出しと選択肢の列。[caption] は見出しの右に小さく添える。 */
+@Composable
+private fun <T> ChoiceSetting(
+    title: String,
+    options: List<T>,
+    selected: T,
+    label: (T) -> String,
+    onSelect: (T) -> Unit,
+    dense: Boolean,
+    caption: String? = null,
+    enabled: Boolean = true,
+) {
+    SettingBlock(dense = dense) {
+        SectionLabel(
+            text = title,
+            modifier = Modifier.alpha(if (enabled) 1f else DISABLED_ALPHA),
+            trailing = if (caption != null) {
+                { Text(caption, style = MaterialTheme.typography.labelMedium, color = UsuzumiText) }
+            } else {
+                null
+            },
+        )
+        Spacer(Modifier.height(if (dense) 8.dp else 10.dp))
+        ChoiceRow(
+            options = options,
+            selected = selected,
+            label = label,
+            onSelect = onSelect,
+            enabled = enabled,
+            height = if (dense) 44.dp else 46.dp,
+        )
+    }
+}
+
+/** 選べない設定の見出しの濃さ。 */
+private const val DISABLED_ALPHA = 0.5f
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+private fun EmptyCardSetting(count: Int, onCountChange: (Int) -> Unit, dense: Boolean) {
+    SettingBlock(dense = dense) {
+        SectionLabel("空札の枚数") {
+            Row {
+                Text(
+                    text = "$count",
+                    modifier = Modifier.alignByBaseline(),
+                    style = MaterialTheme.typography.headlineSmall,
+                    fontWeight = FontWeight.Bold,
+                    color = Sumi,
+                )
+                Text(
+                    text = " 枚",
+                    modifier = Modifier.alignByBaseline(),
+                    style = MaterialTheme.typography.bodyMedium,
+                    color = Sumi,
+                )
+            }
+        }
+        Row(verticalAlignment = Alignment.CenterVertically) {
+            RoundIconButton(
+                icon = R.drawable.ic_minus,
+                contentDescription = "空札を1枚減らす",
+                onClick = { onCountChange(count - 1) },
+                enabled = count > 0,
+            )
+            Slider(
+                value = count.toFloat(),
+                onValueChange = { onCountChange(it.roundToInt()) },
+                modifier = Modifier
+                    .weight(1f)
+                    .padding(horizontal = 6.dp)
+                    .semantics { contentDescription = "空札の枚数" },
+                valueRange = 0f..GameConfig.MAX_EMPTY_CARDS.toFloat(),
+                thumb = { SliderKnob() },
+                track = { SliderLine(it) },
+            )
+            RoundIconButton(
+                icon = R.drawable.ic_plus,
+                contentDescription = "空札を1枚増やす",
+                onClick = { onCountChange(count + 1) },
+                enabled = count < GameConfig.MAX_EMPTY_CARDS,
+            )
+        }
+        val fieldCards = GameConfig.CARDS_PER_SIDE * 2
+        Text(
+            text = "読まれる札は全 ${fieldCards + count} 首" + noLineBreak("（場の札 $fieldCards 枚と空札 $count 枚）"),
+            style = MaterialTheme.typography.bodySmall,
+            color = UsuzumiText,
+        )
+    }
+}
+
+/** スライダーのつまみ。朱の珠に胡粉の縁。 */
+@Composable
+private fun SliderKnob() {
+    Box(
+        Modifier
+            .size(26.dp)
+            .shadow(2.dp, CircleShape)
+            .background(Shu, CircleShape)
+            .border(2.5.dp, Gofun, CircleShape),
+    )
+}
+
+/** スライダーの溝。細い線で、選んだところまでを朱にする。 */
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+private fun SliderLine(state: SliderState) {
+    val range = state.valueRange
+    val span = range.endInclusive - range.start
+    val fraction = if (span > 0f) ((state.value - range.start) / span).coerceIn(0f, 1f) else 0f
+    Canvas(
+        Modifier
+            .fillMaxWidth()
+            .height(6.dp),
+    ) {
+        val y = size.height / 2
+        val stroke = 4.dp.toPx()
+        val rtl = layoutDirection == LayoutDirection.Rtl
+        val startX = if (rtl) size.width else 0f
+        val endX = if (rtl) 0f else size.width
+        val activeX = startX + (endX - startX) * fraction
+        drawLine(WashiDeep, Offset(startX, y), Offset(endX, y), stroke, StrokeCap.Round)
+        drawLine(Shu, Offset(startX, y), Offset(activeX, y), stroke, StrokeCap.Round)
+    }
+}
