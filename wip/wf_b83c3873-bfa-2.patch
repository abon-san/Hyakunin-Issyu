+/** 横に広いが幅に余裕のない画面: 上の帯に見出しと「対戦開始」、その下に設定を2列で並べる。 */
+@Composable
+private fun TopBarSetup(
+    config: GameConfig,
+    onConfigChange: (GameConfig) -> Unit,
+    onStart: () -> Unit,
+    onBack: () -> Unit,
+) {
