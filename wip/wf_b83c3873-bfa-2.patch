+
+/** 設定の項目を並べる、明るい和紙の板。 */
+@Composable
+fun SettingsCard(
+    modifier: Modifier = Modifier,
+    content: @Composable ColumnScope.() -> Unit,
+) {
+    Surface(
+        modifier = modifier.fillMaxWidth(),
+        shape = MaterialTheme.shapes.large,
+        color = WashiLight,
+        border = BorderStroke(1.dp, Kincha.copy(alpha = 0.55f)),
+    ) {
+        Column(Modifier.padding(horizontal = 18.dp, vertical = 4.dp), content = content)
+    }
+}
+
+/** 設定の1項目。[dense] なら上下の余白を詰める（横画面など高さが限られるとき）。 */
+@Composable
+fun SettingBlock(
+    modifier: Modifier = Modifier,
+    dense: Boolean = false,
+    content: @Composable ColumnScope.() -> Unit,
+) {
+    Column(modifier.padding(vertical = if (dense) 10.dp else 14.dp), content = content)
+}
+
+/** 設定の項目どうしの区切り線。 */
+@Composable
+fun PanelDivider() {
+    HorizontalDivider(thickness = 1.dp, color = Kincha.copy(alpha = 0.3f))
+}
+
+/**
+ * 選んでいる項目の説明。どれを選んでも高さが変わらないよう、すべての説明を重ねて一番高いものに合わせ、
+ * 選んでいないものは透明にする。
+ */
+@Composable
+fun <T> SelectedDescription(
+    options: List<T>,
+    selected: T,
+    description: (T) -> String,
+    modifier: Modifier = Modifier,
+) {
+    Box(modifier) {
+        options.forEach { option ->
+            val visible = option == selected
+            Text(
+                text = description(option),
+                modifier = Modifier
+                    .alpha(if (visible) 1f else 0f)
+                    .then(if (visible) Modifier else Modifier.clearAndSetSemantics {}),
+                style = MaterialTheme.typography.bodySmall,
+                color = UsuzumiText,
+            )
+        }
+    }
+}
+
+/** 見出しと説明つきのスイッチ。行全体に触れて切り替えられる。 */
+@Composable
+fun SwitchSetting(
+    title: String,
+    description: String,
+    checked: Boolean,
+    onCheckedChange: (Boolean) -> Unit,
+    modifier: Modifier = Modifier,
+    dense: Boolean = false,
+) {
+    Row(
+        modifier
+            .fillMaxWidth()
+            .toggleable(value = checked, role = Role.Switch, onValueChange = onCheckedChange)
+            .padding(vertical = if (dense) 10.dp else 14.dp),
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        Column(Modifier.weight(1f)) {
+            Text(title, style = MaterialTheme.typography.titleSmall, color = Sumi)
+            Spacer(Modifier.height(2.dp))
+            Text(
+                text = description,
+                style = MaterialTheme.typography.bodySmall,
+                color = UsuzumiText,
+            )
+        }
+        Spacer(Modifier.width(12.dp))
+        Switch(
+            checked = checked,
+            onCheckedChange = null,
+            colors = SwitchDefaults.colors(
+                checkedThumbColor = Gofun,
+                checkedTrackColor = Kon,
+                checkedBorderColor = Kon,
+                uncheckedThumbColor = Usuzumi,
+                uncheckedTrackColor = WashiDeep,
+                uncheckedBorderColor = Usuzumi,
+            ),
+        )
+    }
+}
