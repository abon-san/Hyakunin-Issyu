diff --git a/app/src/test/java/io/github/abonsan/hyakunin/audio/ExoVoicePreviewTest.kt b/app/src/test/java/io/github/abonsan/hyakunin/audio/ExoVoicePreviewTest.kt
new file mode 100644
index 0000000..30cb49e
--- /dev/null
+++ b/app/src/test/java/io/github/abonsan/hyakunin/audio/ExoVoicePreviewTest.kt
@@ -0,0 +1,112 @@
+package io.github.abonsan.hyakunin.audio
+
+import android.content.Context
+import android.media.AudioAttributes
+import android.media.AudioManager
+import android.os.Looper
+import androidx.test.core.app.ApplicationProvider
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import io.github.abonsan.hyakunin.game.voice.AssetVoiceBank
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertSame
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.Shadows.shadowOf
+import org.robolectric.annotation.Config
+import java.time.Duration
+
+/**
+ * 設定の画面の「試聴」の再生器（ExoVoicePreview）を、Robolectric の上でアセットの本物のクリップで動かす。音は出ないので、
+ * 音声フォーカスの扱い（対戦と同じ）と、鳴らす・止める・音量を変える・手放す流れを確かめる。
+ */
+@RunWith(AndroidJUnit4::class)
+@Config(sdk = [36])
+class ExoVoicePreviewTest {
+    private val context = ApplicationProvider.getApplicationContext<Context>()
+    private val audioManager = context.getSystemService(AudioManager::class.java)
+    private var stops = 0
+    private val preview = ExoVoicePreview(context) { stops++ }
+
+    /** 序歌の上の句（「試聴」で鳴らすクリップ）。 */
+    private val joka = "${AssetVoiceBank.DIR}/joka_kami.ogg"
+
+    @After
+    fun tearDown() = preview.release()
+
+    private fun idle() = shadowOf(Looper.getMainLooper()).idleFor(Duration.ofMillis(100))
+
+    @Test
+    fun playingAsksForTheFocusAsGameSpeechAndStoppingGivesItBack() {
+        assertTrue(preview.play(joka, 0.5f))
+        val request = shadowOf(audioManager).lastAudioFocusRequest.audioFocusRequest
+        assertEquals(AudioManager.AUDIOFOCUS_GAIN, request.focusGain)
+        assertEquals(AudioAttributes.USAGE_GAME, request.audioAttributes.usage)
+        assertEquals(AudioAttributes.CONTENT_TYPE_SPEECH, request.audioAttributes.contentType)
+        // 選んだ音量で鳴らす
+        assertEquals(0.5f, preview.outputVolume)
+        idle()
+        preview.stop()
+        assertSame(request, shadowOf(audioManager).lastAbandonedAudioFocusRequest)
+        // 自分で止めたときは知らせない
+        assertEquals(0, stops)
+    }
+
+    @Test
+    fun theVolumeChangesWhilePlaying() {
+        assertTrue(preview.play(joka, 0.3f))
+        idle()
+        preview.setVolume(0.9f)
+        assertEquals(0.9f, preview.outputVolume)
+        // 止めてからもう一度鳴らすと、そのとき渡した音量で（読み直さずに）先頭から鳴る
+        preview.stop()
+        assertTrue(preview.play(joka, 0.6f))
+        assertEquals(0.6f, preview.outputVolume)
+    }
+
+    @Test
+    fun losingTheFocusStopsThePreviewAndTellsTheScreen() {
+        assertTrue(preview.play(joka, 1f))
+        val focus = shadowOf(audioManager).lastAudioFocusRequest
+        focus.listener.onAudioFocusChange(AudioManager.AUDIOFOCUS_LOSS)
+        assertEquals(1, stops)
+        // 止まった後に止めても、もう知らせない
+        preview.stop()
+        assertEquals(1, stops)
+    }
+
+    @Test
+    fun otherAppsShortSoundsOnlyLowerTheVolume() {
+        assertTrue(preview.play(joka, 0.5f))
+        val focus = shadowOf(audioManager).lastAudioFocusRequest
+        focus.listener.onAudioFocusChange(AudioManager.AUDIOFOCUS_LOSS_TRANSIENT_CAN_DUCK)
+        assertEquals(0.5f * VOICE_DUCK_GAIN, preview.outputVolume!!, 1e-6f)
+        focus.listener.onAudioFocusChange(AudioManager.AUDIOFOCUS_GAIN)
+        assertEquals(0.5f, preview.outputVolume)
+        assertEquals(0, stops)
+    }
+
+    @Test
+    fun aRefusedFocusDoesNotPlay() {
+        shadowOf(audioManager).setNextFocusRequestResponse(AudioManager.AUDIOFOCUS_REQUEST_FAILED)
+        assertFalse(preview.play(joka, 1f))
+        // ExoPlayer も作らない
+        assertNull(preview.outputVolume)
+        assertEquals(0, stops)
+    }
+
+    @Test
+    fun nothingPlaysAfterRelease() {
+        assertTrue(preview.play(joka, 1f))
+        assertNotNull(preview.outputVolume)
+        val request = shadowOf(audioManager).lastAudioFocusRequest.audioFocusRequest
+        preview.release()
+        assertSame(request, shadowOf(audioManager).lastAbandonedAudioFocusRequest)
+        assertNull(preview.outputVolume)
+        assertFalse(preview.play(joka, 1f))
+    }
+}
diff --git a/app/src/test/java/io/github/abonsan/hyakunin/audio/OutputGainTest.kt b/app/src/test/java/io/github/abonsan/hyakunin/audio/OutputGainTest.kt
new file mode 100644
index 0000000..6a11907
--- /dev/null
+++ b/app/src/test/java/io/github/abonsan/hyakunin/audio/OutputGainTest.kt
@@ -0,0 +1,73 @@
+package io.github.abonsan.hyakunin.audio
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+/** 再生器が出す音量（OutputGain）: 利用者の音量 × 小さくして止めるときの音量 × ほかの音の間の音量を、変わったときだけ渡す。 */
+class OutputGainTest {
+    /** ExoPlayer に渡した音量（渡した順）。 */
+    private val applied = mutableListOf<Float>()
+    private val gain = OutputGain { applied += it }
+
+    @Test
+    fun theUserVolumeScalesTheFadeOut() {
+        gain.user = 0.6f
+        assertEquals(listOf(0.6f), applied)
+        // 小さくして止めるときは、利用者の音量から 0 へ下げる（1 からではない）
+        for (elapsed in listOf(0L, 75L, 150L)) gain.fade = fadeOutGain(elapsed, 150L)
+        assertEquals(listOf(0.6f, 0.3f, 0f), applied)
+        // 止め終えたら、次のクリップのために利用者の音量へ戻す
+        gain.fade = 1f
+        assertEquals(0.6f, applied.last())
+        assertEquals(0.6f, gain.value)
+    }
+
+    @Test
+    fun theVolumeIsAppliedOnlyWhenItChanges() {
+        // 作ったばかりの ExoPlayer の音量は 1 なので、100% なら何も渡さない
+        gain.user = 1f
+        gain.fade = 1f
+        gain.duck = 1f
+        assertEquals(emptyList<Float>(), applied)
+        gain.user = 0.5f
+        // 同じ値をいくら渡しても（刻みごとに呼ばれても）、ExoPlayer には1回しか渡さない
+        repeat(50) {
+            gain.user = 0.5f
+            gain.fade = 1f
+            gain.duck = 1f
+        }
+        assertEquals(listOf(0.5f), applied)
+    }
+
+    @Test
+    fun duckingMultipliesTheUserVolume() {
+        gain.user = 0.5f
+        gain.duck = VOICE_DUCK_GAIN
+        assertEquals(0.1f, applied.last(), 1e-6f)
+        gain.duck = 1f
+        assertEquals(listOf(0.5f, 0.5f * VOICE_DUCK_GAIN, 0.5f), applied)
+    }
+
+    @Test
+    fun aRebuiltPlayerGetsTheVolumeAgain() {
+        gain.user = 0.4f
+        gain.reattach()
+        assertEquals(listOf(0.4f, 0.4f), applied)
+        // 100% なら、作り直した ExoPlayer の音量（1）のままでよい
+        gain.user = 1f
+        applied.clear()
+        gain.reattach()
+        assertEquals(emptyList<Float>(), applied)
+    }
+
+    @Test
+    fun theUserVolumeIsKeptInRange() {
+        gain.user = 1.5f
+        assertEquals(emptyList<Float>(), applied)
+        gain.user = -0.2f
