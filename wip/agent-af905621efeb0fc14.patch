+
+/** スライダーの値 [value] を、音量の刻み（5%）にそろえる。 */
+internal fun snapVolume(value: Float): Float =
+    (value * VOLUME_STEPS).roundToInt().coerceIn(0, VOLUME_STEPS) / VOLUME_STEPS.toFloat()
