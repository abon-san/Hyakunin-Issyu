+    @Test
+    fun playbackSpeedFollowsTheReadingSpeed() {
+        assertEquals(0.85f, ReadingSpeed.SLOW.playbackSpeed)
+        assertEquals(1.0f, ReadingSpeed.NORMAL.playbackSpeed)
+        assertEquals(1.2f, ReadingSpeed.FAST.playbackSpeed)
