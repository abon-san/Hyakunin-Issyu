+        assertEquals(MatchPhase.Reading, h.state.phase)
+    }
+
+    @Test
+    fun cpuTakesTheCardWhenPlayerDoesNothing() {
+        val h = harness(factory = layout(order = listOf(6, 11), profile = steadyCpu(300L)))
+        advance(1500L)
+        assertEquals(MatchPhase.Reading, h.state.phase)
