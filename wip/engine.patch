+            val s = e.beginRead()
+            assertEquals(3, s.kimarijiLength)
+            // 上の句 3文字 = 300ms、下の句は 300ms の間 + 1文字 = 700ms
+            assertEquals(700L, s.shimoEnd - s.startMillis)
+            assertEquals(CpuPlan.Take(s.shimoEnd + 500L), s.cpuPlan)
